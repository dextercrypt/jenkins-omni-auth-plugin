<!--
  Login error page. Served at securityRealm/loginError, forwarded here from
  /loginError by LoginErrorInterceptor when the OmniAuth realm is active.

  This delegates to login.jelly with error=true so the error page ALWAYS
  inherits every login-page customisation (animated background, background
  selector, company logo, dark panel, banner, footer) automatically.
  Single source of truth — no duplication, no drift.
-->
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
  <j:set var="error" value="${true}"/>
  <st:include it="${it}" page="login.jelly"/>
</j:jelly>
