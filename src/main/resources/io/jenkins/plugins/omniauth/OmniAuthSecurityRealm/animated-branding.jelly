<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core">
  <!--
    Animated branding panel.
    IMPORTANT: do NOT override `position` here. Jenkins' own CSS sets this section to
    `position:fixed; width:40vw; height:100vh` and flex-centers the logo. Overriding position
    drops it into normal flow and breaks the whole two-column layout.
    We only add a background colour; the canvas is absolutely positioned inside the fixed
    section (inset:0) and the logo stays a normal flex-centered child (sized by Jenkins CSS).
  -->
  <section class="app-sign-in-register__branding"
           style="background:linear-gradient(135deg,#080b1e 0%,#0a1026 50%,#0c1430 100%);">

    <!--
      Kill Jenkins' native colourful starburst blobs. Core paints two pseudo-elements
      (.app-sign-in-register__branding::before / ::after) of radial gradients at z-index:-1 —
      ON TOP of this section's own background but BEHIND the canvas. The canvas is transparent
      until JS paints its first frame, so on reload those blobs flash through for a beat
      ("stardust"). Removing them means the pre-paint state is just our dark base gradient,
      visually identical to the animation's drawBG() — no flash. Only applies in animated mode
      (this jelly isn't included for the 'starburst' background option).
    -->
    <style>
      .app-sign-in-register__branding::before,
      .app-sign-in-register__branding::after { content: none !important; background: none !important; }
    </style>

    <canvas id="omniauth-bg-canvas"
            style="position:absolute;inset:0;display:block;z-index:0;"></canvas>

    
    <j:choose>
      <j:when test="${it.loginButler == 'jenkinsx'}">
    <!-- Company butler: Jenkins 'JayeX' / Jenkins X logo, inlined for pre-auth render.
         Source: https://www.jenkins.io/images/logos/jenkins-x/jenkins-x.svg  | Gallery: https://www.jenkins.io/artwork/
         CC BY-SA 3.0 (Jenkins project). Butler leaning over a Kubernetes-helm badge; viewBox/aspect already matched (no letterbox). -->
    <svg viewBox="0 0 226 312" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" id="svg-jenkinsx" style="position:relative;z-index:1;height:40vh;width:auto;overflow:visible;filter:drop-shadow(0 0 28px rgba(34,211,238,0.45));"><g transform="translate(113.00,156.00) scale(0.82718) translate(-132.800,-164.550)"><g transform="translate(-164.82 -209.05)"><path d="m329.69 418.38-.06 1.62c-2.21 1.45-5.77 1.43-8.2 2.65a21.06 21.06 0 0 1 8.82 2.23c-.05 1.34-.11 2.69-.16 4-4 2.77-7.74 6.89-12.5 9.49-2.26 1.23-10.16 4.39-12.56 3.83-1.35-.31-1.48-2-2-3.58-1.15-3.4-3.81-8.81-4-13.92-.3-6.46-1-17.28 6-15.95a62.39 62.39 0 0 1 16.49 6c2.6 1.53 4.14 3.32 8.17 3.63z" fill="none" stroke="#d23933" stroke-width="2.5"></path><path d="m304.46 231.38a17.84 17.84 0 0 0 -13.65 0l-91.17 43.9a17.88 17.88 0 0 0 -8.51 10.72l-22.52 98.65a17.82 17.82 0 0 0 3 13.31l63.13 79.04a17.84 17.84 0 0 0 12.26 6h101.2a17.82 17.82 0 0 0 12.33-6l63.1-79.12a17.87 17.87 0 0 0 3-13.31l-22.48-98.57a17.88 17.88 0 0 0 -8.51-10.68z" fill="#d23933" stroke="#221f1f" stroke-width="7"></path><path d="m354 258.41 5.38 8.61 6.62 12.09 1.67 30-5 25.83-9.17 22.92-8.75 12.08-6.25 6.67-16.67 2.5-22.49 2.5-14.59.41-14.17-.41-10.83-3.34-9.58-10.41-7.5-21.25-1.67-4.61-10-3.33-5.83-9.58-4.17-13.73 4.58-12.09 10.84-3.75 8.75 4.17 4.17 9.17 5-.84 1.66-2.08-1.66-9.58-.34-12.09 1-6.79 1.5-.51 5-1.67c9.07-3 13.07-4.36 18.29-6.54l1-.41c2.92-1.24 4.7-2.08 10.42-4.81 13.21-6.32 19.44-8.47 26.57-8.47.46 0 1.4 0 2.92.1l5.21.26c3.4.16 6.2.27 8.92.34a109.46 109.46 0 0 0 13.92-.38 32.43 32.43 0 0 0 5.25-.98z" fill="#f0d6b7"></path><path d="m354 258.41 5.38 8.61 6.62 12.09 1.67 30-5 25.83-9.17 22.92-8.75 12.08-6.25 6.67-16.67 2.5-22.49 2.5-14.59.41-14.17-.41-10.83-3.34-9.58-10.41-7.5-21.25-1.67-4.61-10-3.33-5.83-9.58-4.17-13.73 4.58-12.09 10.84-3.75 8.75 4.17 4.17 9.17 5-.84 1.66-2.08-1.66-9.58-.34-12.09 1-6.79 1.5-.51 5-1.67c9.07-3 13.07-4.36 18.29-6.54l1-.41c2.92-1.24 4.7-2.08 10.42-4.81 13.21-6.32 19.44-8.47 26.57-8.47.